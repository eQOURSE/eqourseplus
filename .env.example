# ---- copy to .env (never commit .env) ----
NODE_ENV=development
# Development defaults only. Set production URL configuration in Vercel Production,
# not in this file.
# Server-only web origin used at runtime for the CSRF exact-origin allow-list
APP_URL=http://localhost:3000
# Server-only API origin used at runtime by the web auth Route Handlers
API_URL=http://localhost:4000
# Browser-facing API origin inlined at build time for registration and OTP requests
NEXT_PUBLIC_API_URL=http://localhost:4000
# Exact comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Mongo (Atlas connection string). Cloud Run maps MONGODB_URI_STAGING for
# staging and the unsuffixed MONGODB_URI secret for production.
MONGODB_URI=
# Auth. Cloud Run maps JWT_SECRET_STAGING for staging and the unsuffixed
# JWT_SECRET secret for production; use a separate value per environment.
JWT_SECRET=
# Dedicated keyed HMAC secret for canonical vendor identifier lookup digests.
VENDOR_IDENTIFIER_HMAC_SECRET=
# Separate keyed HMAC secret for client identifiers; rotation requires digest recomputation and index rebuild.
CLIENT_IDENTIFIER_HMAC_SECRET=
# Redis (Upstash)
REDIS_URL=
# Storage (Cloudflare R2 - S3 compatible)
STORAGE_PROVIDER=sandbox
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUCKET_ASSETS=eqplus-project-assets
# KYC provider (sandbox first) — via KYCAdapter
KYC_PROVIDER=sandbox   # sandbox|idfy|sumsub
IDFY_API_KEY=
SUMSUB_APP_TOKEN=
# E-sign — via ESignAdapter
ESIGN_PROVIDER=sandbox # sandbox|digio|dropboxsign
# Payouts — via PayoutAdapter
PAYOUT_PROVIDER=sandbox # sandbox|razorpayx|wise
# Email provider. Keep sandbox for local development and CI; use resend only
# after the sending domain and its SPF, DKIM and DMARC records are verified.
MAILER_PROVIDER=sandbox # sandbox|resend
# Required only when MAILER_PROVIDER=resend. Store the real value in the
# deployment secret manager; never commit it or put it in logs.
RESEND_API_KEY=
# Optional. When set, the adapter tries this published template and falls back
# to the self-contained plain-text OTP email if the template request fails.
RESEND_EMAIL_TEMPLATE_ID=
# Verified From address or "Display name <address>" on the Resend domain.
OTP_EMAIL_FROM=
# The SMS adapter port has no configured external provider.
SMS_PROVIDER=sandbox
# LLM (AI features)
ANTHROPIC_API_KEY=
# Offline admin-only assessment draft generation via Gemini Flash; never used by request handlers.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
# Monitoring
# API Sentry DSN; leave empty to disable reporting
SENTRY_DSN=
# Web Sentry DSN; intentionally browser-exposed (public DSN, safe by design)
NEXT_PUBLIC_SENTRY_DSN=
